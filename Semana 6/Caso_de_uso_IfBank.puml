@startuml casos_uso_pix

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Cliente
actor "Sistema BACEN" as BACEN

rectangle "Sistema IFBank - Área Pix" {
  usecase "Autenticar Usuário" as UC1
  usecase "Consultar Saldo" as UC2
  usecase "Cadastrar Chave Pix" as UC3
  usecase "Realizar Pix" as UC4
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4

BACEN --> UC3
BACEN --> UC4

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>

@enduml
